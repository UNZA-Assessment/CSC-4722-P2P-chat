# =============================================================================
# P2P_PEERS.env — shared peer map for the distributed chat cluster
# =============================================================================
#
# WHAT THIS FILE DOES
# --------------------
# Maps every node's PORT to the machine it runs on. Every laptop in the
# cluster must `source` this SAME file (or set the same P2P_PEERS value)
# before starting a node, so everyone agrees on where everyone else lives.
#
# Format:   PORT=HOST,PORT=HOST,PORT=HOST,...
#   - PORT is the node's port number (portBase + nodeId), e.g. 8000, 8001...
#   - HOST can be EITHER a raw IP address (e.g. 192.168.1.23)
#           OR a hostname already defined in /etc/hosts (e.g. node-alpha)
#     Both work identically — NetworkClient just builds a URL like
#     http://HOST:PORT/... and lets the OS resolve it either way.
#
# -----------------------------------------------------------------------------
# HOW TO ADD OR CHANGE AN ENTRY
# -----------------------------------------------------------------------------
# 1. Find the port for the node you're adding (portBase + nodeId).
#      e.g. with portBase=8000, node 4 is port 8004.
# 2. Find that machine's address:
#      - Raw IP:      run `hostname -I` (Linux) or `ipconfig` (Windows)
#      - /etc/hosts name: run `cat /etc/hosts` on that machine to see what
#        names already exist, then confirm it's current with:
#          getent hosts <name>     # shows what IP it resolves to right now
#          ping -c 1 <name>        # confirms it's actually reachable today
#        (Some names in /etc/hosts on these laptops are left over from an
#        earlier cluster project — always re-check with the two commands
#        above before trusting an old name, since laptops may have been
#        reassigned different IPs since then.)
# 3. Append PORT=HOST to the P2P_PEERS line below, comma-separated, no spaces.
# 4. Copy the FULL updated line to every laptop in the cluster — everyone
#    must use the exact same P2P_PEERS value.
#
# -----------------------------------------------------------------------------
# RUNNING MULTIPLE NODES ON THE SAME MACHINE
# -----------------------------------------------------------------------------
# It's fine for more than one port to point at the same HOST (e.g. if you
# have fewer laptops than nodes) — just repeat that machine's address for
# each port it's hosting. Node.java will print a note about it at startup
# but will only refuse to start if a single host is asked to run more nodes
# than the safety ceiling allows (see MAX_NODES_PER_HOST in Node.java).
#
# =============================================================================

export P2P_BASE_PORT=8000

# --- ACTIVE CONFIG: edit this line for your current run -----------------
# Using raw IPs. Replace with your laptops' real addresses before each
# session — Wi-Fi/DHCP IPs can change between sessions.
export P2P_PEERS='8000=192.168.1.3,8001=192.168.1.3,8002=192.168.1.3,8003=192.168.1.1, 8004=192.168.1.4' 

# --- EXAMPLE: same thing, using /etc/hosts names instead of raw IPs -----
# Uncomment and edit if you'd rather use names already set up on these
# machines. Verify each name with `getent hosts <name>` first (see above).
# export P2P_PEERS='8000=node-alpha,8001=node-alpha,8002=node-alpha,8003=node-beta'

# --- EXAMPLE: one node per machine (no doubling up) ----------------------
# export P2P_PEERS='8000=192.168.1.10,8001=192.168.1.11,8002=192.168.1.12'
