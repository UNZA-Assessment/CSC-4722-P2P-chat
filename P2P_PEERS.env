# Shared peer map: port=LAN_IP
# Replace the placeholder IP addresses with the actual IP of each PC.
# Use the same file on every PC in the cluster.

export P2P_BASE_PORT=8000
export P2P_PEERS='8000=10.168.132.121,8001=10.168.132.206,8002=PC_C_IP,8003=PC_D_IP,8004=PC_E_IP,8005=PC_F_IP,8006=PC_G_IP,8007=PC_H_IP,8008=PC_I_IP,8009=PC_J_IP'

# Example:
# export P2P_PEERS='8000=10.168.132.121,8001=10.168.132.206,8002=10.168.132.140'
